PORT=3001

# From Google Cloud Console → APIs & Services → Credentials (OAuth client ID, type "Web application").
# See ../README.md for the exact steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match a redirect URI registered on that OAuth client.
# For local dev this is the server's own callback route.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/accounts/oauth2callback

# How often (ms) to poll Google Calendar for changes. Default: 3 minutes.
SYNC_INTERVAL_MS=180000
